<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup/DPI via its manifest. WinForms is used only for NotifyIcon,
         so its ApplicationConfiguration-based DPI analyzer does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Logo.png" />
    <Resource Include="Assets/App.ico" />
    <Resource Include="Assets/Help/*.png" />
    <ProjectReference Include="../TIAAutoSaveManager.Infrastructure/TIAAutoSaveManager.Infrastructure.csproj" />
    <ProjectReference Include="../TIAAutoSaveManager.OpennessHost/TIAAutoSaveManager.OpennessHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyOpennessHost" AfterTargets="Build">
    <ItemGroup><HostFiles Include="../TIAAutoSaveManager.OpennessHost/bin/$(Configuration)/net48/*.*" /></ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(OutDir)host" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishOpennessHost" AfterTargets="Publish">
    <ItemGroup><HostPublishFiles Include="../TIAAutoSaveManager.OpennessHost/bin/$(Configuration)/net48/*.*" /></ItemGroup>
    <Copy SourceFiles="@(HostPublishFiles)" DestinationFolder="$(PublishDir)host" SkipUnchangedFiles="true" />
  </Target>
</Project>
